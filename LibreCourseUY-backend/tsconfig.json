{
  "compilerOptions": {
    /* Runtime */
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",

    /* Node */
    "types": ["node"],

    /* Interop */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Output */
    "sourceMap": true,

    /* Type Safety */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* Performance */
    "skipLibCheck": true
  }
}